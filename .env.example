# === Variables d'environnement attendues (copier en .env, sans committer .env) ===
# La vitrine v1 est 100 % statique et ne requiert AUCUN secret.
# Ces variables concernent la PHASE 2 (formulaire de contact, RDV, visio).

# Endpoint de traitement du formulaire de contact (ex. Web3Forms, Formspree, ou API phase 2).
# Préfixe PUBLIC_ = exposé au client (requis pour Astro côté navigateur). Non secret.
# Si vide, le formulaire retombe sur un e-mail pré-rempli (mailto).
# PUBLIC_CONTACT_ENDPOINT=

# Clé publique du service anti-spam (ex. Turnstile/hCaptcha) — côté client, non secrète
# PUBLIC_CAPTCHA_SITE_KEY=

# --- Phase 2 (RDV / téléconsultation) : à définir le moment venu ---
# DATABASE_URL=
# SESSION_SECRET=
# TURN_SERVER_URL=
