---
/**
 * Pied de page : marque + baseline, navigation, contact rapide, infos pro (RPPS,
 * horaires), réseaux sociaux (icônes) et barre légale. Les liens externes
 * utilisent rel="noopener noreferrer" (sécurité : empêche l'accès à window.opener).
 */
import { Image } from 'astro:assets';
import { primaryNav, site } from '../config/site';
import mark from '../assets/logo-mark.png';

const year = new Date().getFullYear();
const wa = `https://wa.me/${site.contact.phoneHref.replace('+', '')}`;
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <!-- Marque -->
    <div class="site-footer__brand">
      <a class="foot-brand" href="/" aria-label="PSY2A, Accueil">
        <span class="foot-brand__mark"><Image src={mark} alt="" widths={[52, 104]} sizes="48px" format="webp" loading="lazy" /></span>
        <span class="foot-brand__word">PSY2A<span class="foot-brand__sub"><span class="fb-l fb-l--m">M</span>.<span class="fb-l fb-l--a">A</span>.<span class="fb-l fb-l--y">Y</span>. <span class="fb-full">Maux · Aide · Yeux</span></span></span>
      </a>
      <p class="site-footer__blurb">
        Vos consultations à distance (enfants · ados · adultes · couples).
      </p>
      <ul class="site-footer__social" aria-label="Réseaux sociaux">
        <li><a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>
        </a></li>
        <li><a href={site.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.5a3 3 0 0 0-2.1-2.1C19 4.9 12 4.9 12 4.9s-7 0-8.9.5A3 3 0 0 0 1 7.5 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.5a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23.5 12 31 31 0 0 0 23 7.5zM9.8 15.3V8.7l5.7 3.3-5.7 3.3z"/></svg>
        </a></li>
        <li><a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0zM.5 8h4V24h-4V8zM8 8h3.8v2.2h.1c.5-1 1.8-2.2 3.8-2.2 4 0 4.8 2.6 4.8 6.1V24h-4v-7c0-1.7 0-3.8-2.3-3.8s-2.7 1.8-2.7 3.7V24H8V8z"/></svg>
        </a></li>
      </ul>
    </div>

    <!-- Navigation -->
    <nav class="site-footer__col" aria-label="Navigation du pied de page">
      <p class="site-footer__heading">Navigation</p>
      <ul>
        {primaryNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <!-- Contact -->
    <div class="site-footer__col">
      <p class="site-footer__heading">Contact</p>
      <ul>
        <li><a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a></li>
        <li><a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
        <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
      </ul>
    </div>

    <!-- Infos -->
    <div class="site-footer__col">
      <p class="site-footer__heading">Informations</p>
      <p class="site-footer__info">
        {site.practitionerName}<br />
        {site.practitionerTitle}<br />
        RPPS {site.registration.rpps}
      </p>
      <p class="site-footer__info"><strong>Horaires</strong><br />{site.hours}</p>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} PSY2A. Tous droits réservés.</p>
    <ul class="site-footer__legal">
      <li><a href="/mentions-legales/">Mentions légales</a></li>
      <li><a href="/confidentialite/">Politique de confidentialité</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }
  .site-footer__grid {
    display: grid; gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: 1.8fr 1fr 1fr 1.2fr;
    padding-block: clamp(2.5rem, 5vw, 3.5rem) var(--space-6);
  }

  /* Marque */
  .foot-brand { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; }
  .foot-brand__mark { display: grid; place-items: center; height: 48px; width: 48px; flex: none; background: #fff; border-radius: 12px; padding: 5px; box-shadow: var(--shadow-1); }
  .foot-brand__mark img { height: 100%; width: auto; }
  .foot-brand__word { display: flex; flex-direction: column; line-height: 1; font-weight: 800; font-size: 1.35rem; color: var(--color-text); }
  .foot-brand__sub { font-size: .58rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--color-muted); margin-top: 4px; }
  .fb-l { font-weight: 800; }
  .fb-l--m { color: var(--color-primary); }
  .fb-l--a { color: var(--color-accent); }
  .fb-l--y { color: var(--color-primary-bright); }
  .site-footer__blurb { color: var(--color-muted); font-size: var(--fs-100); margin-top: var(--space-4); max-width: 42ch; }

  .site-footer__social { list-style: none; display: flex; gap: var(--space-2); padding: 0; margin-top: var(--space-5); }
  .site-footer__social a {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    background: var(--color-surface-2); color: var(--color-primary);
    border: 1px solid var(--color-border); transition: background-color .15s ease, color .15s ease, transform .15s ease;
  }
  .site-footer__social a:hover { background: var(--color-primary); color: var(--color-on-primary); transform: translateY(-2px); }
  .site-footer__social svg { width: 1.1rem; height: 1.1rem; }

  /* Colonnes */
  .site-footer__heading { font-weight: 800; margin-bottom: var(--space-3); }
  .site-footer__col ul { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .site-footer__col a { text-decoration: none; color: var(--color-muted); }
  .site-footer__col a:hover { color: var(--color-primary); }
  .site-footer__info { color: var(--color-muted); font-size: var(--fs-100); margin-top: var(--space-3); }
  .site-footer__info strong { color: var(--color-text); }

  /* Barre légale */
  .site-footer__bottom {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-4); color: var(--color-muted); font-size: var(--fs-100);
    display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: space-between; align-items: center;
  }
  .site-footer__legal { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-4); padding: 0; margin: 0; }
  .site-footer__legal a { color: var(--color-muted); text-decoration: none; }
  .site-footer__legal a:hover { color: var(--color-primary); text-decoration: underline; }

  @media (max-width: 860px) {
    .site-footer__grid { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .site-footer__grid { grid-template-columns: 1fr; }
  }
</style>
