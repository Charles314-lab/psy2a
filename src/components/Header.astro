---
/**
 * En-tête du site : marque, navigation principale, CTA rendez-vous,
 * bascule de thème clair/sombre. Menu accessible (clavier + ARIA) et
 * repliable en version mobile.
 */
import { Image } from 'astro:assets';
import { primaryNav } from '../config/site';
import mark from '../assets/logo-mark.png';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="PSY2A, Accueil">
      <span class="brand__mark">
        <Image
          src={mark}
          alt="Logo PSY2A"
          widths={[48, 96]}
          sizes="44px"
          format="webp"
          loading="eager"
        />
      </span>
      <span class="brand__word">
        PSY2A
        <span class="brand__sub"><span class="brand__letter brand__letter--m">M</span>.<span class="brand__letter brand__letter--a">A</span>.<span class="brand__letter brand__letter--y">Y</span>. <span class="brand__full">Maux · Aide · Yeux</span></span>
      </span>
    </a>

    <!-- Bouton d'ouverture du menu (mobile) -->
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" type="button">
      <span class="visually-hidden">Ouvrir le menu de navigation</span>
      <span class="nav-toggle__icon" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Navigation principale">
      <ul class="site-nav__list">
        {primaryNav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary site-nav__cta" href="/contact/">Prendre rendez-vous</a>
    </nav>

    <button class="theme-toggle" type="button" title="Basculer le thème clair / sombre">
      <span class="visually-hidden">Basculer le thème clair ou sombre</span>
      <span class="theme-toggle__icon" aria-hidden="true">◐</span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: saturate(1.3) blur(10px);
    -webkit-backdrop-filter: saturate(1.3) blur(10px);
    border-bottom: 1px solid var(--color-border);
    transition: box-shadow .2s ease, background-color .2s ease;
  }
  /* Ombre douce dès qu'on défile (classe posée par le script). */
  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--color-bg) 97%, transparent);
    box-shadow: 0 8px 24px -16px rgba(19, 35, 63, .55);
  }
  .site-header__inner {
    display: flex; align-items: center; gap: var(--space-4);
    min-height: var(--header-h);
  }
  .brand { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; }
  /* Marque (œil + arbre) sur petite plaque blanche : nette en thème clair comme sombre. */
  .brand__mark {
    display: grid; place-items: center; height: 46px; width: 46px; flex: none;
    background: #fff; border-radius: 12px; padding: 5px; box-shadow: var(--shadow-1);
  }
  .brand__mark img { height: 100%; width: auto; display: block; }
  .brand__word {
    display: flex; flex-direction: column; line-height: 1;
    font-weight: 800; font-size: 1.35rem; letter-spacing: .01em; color: var(--color-text);
  }
  .brand__sub {
    font-size: .58rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
    color: var(--color-muted); margin-top: 4px;
  }
  .brand__letter { font-weight: 800; }
  .brand__letter--m { color: var(--color-primary); }
  .brand__letter--a { color: var(--color-accent); }
  .brand__letter--y { color: var(--color-primary-bright); }

  .site-nav { display: flex; align-items: center; gap: var(--space-5); margin-left: auto; }
  .site-nav__list { list-style: none; display: flex; gap: var(--space-5); padding: 0; }
  .site-nav__list a {
    text-decoration: none; color: var(--color-text); font-weight: 500; padding-block: var(--space-2);
    border-bottom: 2px solid transparent;
  }
  .site-nav__list a:hover { color: var(--color-primary); }
  .site-nav__list a[aria-current='page'] { color: var(--color-primary); border-bottom-color: var(--color-primary); }

  .theme-toggle, .nav-toggle {
    background: transparent; border: 1px solid var(--color-border); color: var(--color-text);
    width: 44px; height: 44px; border-radius: var(--radius-sm); cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .theme-toggle__icon { font-size: 1.25rem; line-height: 1; }
  .nav-toggle { display: none; }
  .nav-toggle__icon, .nav-toggle__icon::before, .nav-toggle__icon::after {
    content: ''; display: block; width: 20px; height: 2px; background: currentColor; position: relative;
  }
  .nav-toggle__icon::before { position: absolute; top: -6px; }
  .nav-toggle__icon::after  { position: absolute; top: 6px; }

  /* --- Mobile --- */
  @media (max-width: 860px) {
    .nav-toggle { display: inline-flex; order: 3; }
    .theme-toggle { order: 2; margin-left: auto; }
    .site-nav {
      order: 4; flex-basis: 100%; flex-direction: column; align-items: stretch; gap: var(--space-3);
      max-height: 0; overflow: hidden; transition: max-height .25s ease;
    }
    .site-nav.is-open { max-height: 32rem; padding-bottom: var(--space-4); }
    .site-nav__list { flex-direction: column; gap: 0; }
    .site-nav__list a { display: block; padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border); }
    .site-nav__cta { width: 100%; }
  }
</style>

<script>
  // Menu mobile : bascule aria-expanded + classe d'ouverture.
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });

  // Ombre du header au défilement (rappel visuel qu'il reste fixe).
  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Thème clair/sombre, mémorisé dans localStorage.
  const themeBtn = document.querySelector('.theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (_) { /* stockage indisponible */ }
  });
</script>
