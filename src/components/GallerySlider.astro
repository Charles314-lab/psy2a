---
/**
 * Slider de la galerie du cabinet.
 * Défilement auto (pause au survol / focus / hors-écran), flèches, points,
 * swipe tactile natif (scroll-snap), et respect de prefers-reduced-motion.
 */
import { Image } from 'astro:assets';
import c1 from '../assets/gallery/cabinet-1.jpg';
import c2 from '../assets/gallery/cabinet-2.jpg';
import c3 from '../assets/gallery/cabinet-3.jpg';
import c4 from '../assets/gallery/cabinet-4.jpg';
import c5 from '../assets/gallery/cabinet-5.jpg';
import c6 from '../assets/gallery/cabinet-6.jpg';

const slides = [c1, c2, c3, c4, c5, c6];
---

<div class="gslider" data-gslider>
  <div class="gslider__track" data-track>
    {slides.map((img, i) => (
      <figure class="gslide">
        <Image
          src={img}
          alt={`Le cabinet PSY2A en images (${i + 1})`}
          widths={[500, 800, 1100]}
          sizes="(max-width: 800px) 88vw, 720px"
          format="webp"
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      </figure>
    ))}
  </div>
  <button class="gslider__nav gslider__nav--prev" type="button" data-prev aria-label="Photo précédente">‹</button>
  <button class="gslider__nav gslider__nav--next" type="button" data-next aria-label="Photo suivante">›</button>
  <div class="gslider__dots" data-dots></div>
</div>

<style>
  .gslider { position: relative; margin-top: var(--space-6); }
  .gslider__track {
    display: flex; gap: var(--space-4); overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-behavior: smooth; padding-block: var(--space-2); scrollbar-width: none;
  }
  .gslider__track::-webkit-scrollbar { display: none; }
  .gslide {
    flex: 0 0 min(720px, 86%); scroll-snap-align: center; margin: 0;
    border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-2);
  }
  .gslide :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
  .gslider__nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 46px; height: 46px; border-radius: 50%; border: 0; cursor: pointer;
    background: var(--color-primary); color: var(--color-on-primary); font-size: 1.6rem; line-height: 1;
    display: grid; place-items: center; box-shadow: var(--shadow-2); opacity: .94;
    transition: transform .15s ease, background .15s ease;
  }
  .gslider__nav:hover { background: var(--color-primary-hover); transform: translateY(-50%) scale(1.06); }
  .gslider__nav--prev { left: 8px; }
  .gslider__nav--next { right: 8px; }
  .gslider__dots { display: flex; gap: .5rem; justify-content: center; margin-top: var(--space-4); }
  .gslider__dots button {
    width: 9px; height: 9px; border-radius: 50%; border: 0; cursor: pointer; padding: 0;
    background: var(--color-border); transition: background .2s ease, transform .2s ease;
  }
  .gslider__dots button[aria-selected='true'] { background: var(--color-primary); transform: scale(1.3); }
  @media (max-width: 560px) { .gslider__nav { display: none; } }
</style>

<script>
  document.querySelectorAll('[data-gslider]').forEach((root) => {
    const track = root.querySelector('[data-track]') as HTMLElement;
    const slides = Array.from(track.children) as HTMLElement[];
    const dotsWrap = root.querySelector('[data-dots]') as HTMLElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;

    slides.forEach((_, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', 'Aller à la photo ' + (i + 1));
      b.addEventListener('click', () => goTo(i));
      dotsWrap.appendChild(b);
    });
    const dots = Array.from(dotsWrap.children) as HTMLElement[];

    const setActive = (i: number) => {
      current = i;
      dots.forEach((d, j) => d.setAttribute('aria-selected', String(j === i)));
    };
    const goTo = (i: number) => {
      const n = (i + slides.length) % slides.length;
      slides[n].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      setActive(n);
    };

    (root.querySelector('[data-prev]') as HTMLElement).addEventListener('click', () => goTo(current - 1));
    (root.querySelector('[data-next]') as HTMLElement).addEventListener('click', () => goTo(current + 1));

    // Synchronise les points quand l'utilisateur fait défiler à la main.
    let scrollT: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => {
      clearTimeout(scrollT);
      scrollT = setTimeout(() => {
        const center = track.scrollLeft + track.clientWidth / 2;
        let best = 0, bestDist = Infinity;
        slides.forEach((s, i) => {
          const c = s.offsetLeft + s.clientWidth / 2 - track.offsetLeft;
          const d = Math.abs(c - center);
          if (d < bestDist) { bestDist = d; best = i; }
        });
        setActive(best);
      }, 90);
    }, { passive: true });

    setActive(0);

    // Défilement automatique, en pause hors interaction / hors écran.
    if (!reduce) {
      let timer: ReturnType<typeof setInterval> | null = null;
      const start = () => { stop(); timer = setInterval(() => goTo(current + 1), 4500); };
      const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      const io = new IntersectionObserver((e) => (e[0].isIntersecting ? start() : stop()), { threshold: 0.3 });
      io.observe(root);
    }
  });
</script>
