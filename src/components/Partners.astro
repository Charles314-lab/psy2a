---
import { Image } from 'astro:assets';
import canada from '../assets/partners/canada.png';
import france from '../assets/partners/france.jpg';
import orange from '../assets/partners/orange.png';
import care from '../assets/partners/care.png';
import cicr from '../assets/partners/cicr.jpg';
import suisse from '../assets/partners/suisse.jpg';
import savethechildren from '../assets/partners/save-the-children.png';
import adminPenit from '../assets/partners/admin-penitentiaire.png';
import minJustice from '../assets/partners/ministere-justice.png';
import ceaAlsace from '../assets/partners/cea-alsace.png';

const maliPartners = [
  { img: care, name: 'CARE' },
  { img: cicr, name: 'Comite International de la Croix-Rouge' },
  { img: savethechildren, name: 'Save the Children' },
  { img: canada, name: 'Ambassade du Canada' },
  { img: france, name: 'Ambassade de France' },
  { img: suisse, name: 'Ambassade de Suisse' },
  { img: orange, name: 'Orange Mali' },
];

const francePartners = [
  { img: adminPenit, name: 'Administration penitentiaire de Seine-et-Marne' },
  { img: minJustice, name: 'Protection Judiciaire de la Jeunesse (PJJ) de Haute-Vienne' },
  { img: ceaAlsace, name: "Aide Sociale a l'Enfance (ASE) d'Alsace" },
];
---

<div class="partners">
  <h3 class="partners__region">Mali</h3>
  <ul class="partners-grid" role="list">
    {maliPartners.map((p) => (
      <li class="partner">
        <Image src={p.img} alt={p.name} title={p.name} widths={[140, 280]} sizes="150px" format="webp" loading="lazy" />
      </li>
    ))}
  </ul>

  <h3 class="partners__region">France</h3>
  <ul class="partners-grid" role="list">
    {francePartners.map((p) => (
      <li class="partner">
        <Image src={p.img} alt={p.name} title={p.name} widths={[140, 280]} sizes="150px" format="webp" loading="lazy" />
      </li>
    ))}
  </ul>
</div>

<style>
  .partners__region {
    font-size: var(--fs-300); font-weight: 700; color: var(--color-primary);
    margin-top: var(--space-6); margin-bottom: var(--space-3);
    text-transform: uppercase; letter-spacing: .06em;
  }
  .partners__region:first-child { margin-top: 0; }
  .partners-grid {
    list-style: none; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: var(--space-4);
  }
  .partner {
    display: grid; place-items: center; background: #fff;
    border: 1px solid var(--color-border); border-radius: var(--radius);
    padding: var(--space-4); min-height: 92px; box-shadow: var(--shadow-1);
  }
  .partner :global(img) {
    width: auto; height: auto; max-height: 56px; max-width: 100%; object-fit: contain;
    filter: grayscale(.55); opacity: .85;
    transition: filter .2s ease, opacity .2s ease, transform .2s ease;
  }
  .partner:hover :global(img) { filter: grayscale(0); opacity: 1; transform: scale(1.05); }
</style>
